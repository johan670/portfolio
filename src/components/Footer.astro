---
const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-zinc-100">
  <div class="flex items-center justify-between px-6 py-8 md:px-10 lg:px-16 max-w-screen-xl mx-auto">
    <p class="text-sm text-zinc-400">© {year} Your Name</p>
    <div class="flex items-center gap-6">
      <a
        href="https://linkedin.com"
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-zinc-400 hover:text-zinc-900 transition-colors duration-200"
      >
        LinkedIn
      </a>
      <a
        href="https://dribbble.com"
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-zinc-400 hover:text-zinc-900 transition-colors duration-200"
      >
        Dribbble
      </a>
      <a
        href="https://read.cv"
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-zinc-400 hover:text-zinc-900 transition-colors duration-200"
      >
        CV
      </a>
    </div>
  </div>
</footer>
