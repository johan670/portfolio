---
interface Props {
  title: string;
  description: string;
  href: string;
  cover?: string;
  tags?: string[];
  year?: string;
}

const { title, description, href, cover, tags = [], year } = Astro.props;
---

<a href={href} class="group block">
  <!-- Image -->
  <div class="relative overflow-hidden bg-zinc-100 aspect-[4/3] mb-4">
    {cover && (
      <img
        src={cover}
        alt={title}
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
        onerror="this.style.display='none'"
      />
    )}
    <div class="absolute inset-0 bg-black/0 group-hover:bg-black/5 transition-colors duration-300" />
  </div>

  <!-- Meta -->
  <div class="flex items-start justify-between gap-4 mb-1.5">
    <h3 class="text-sm font-medium text-zinc-900 group-hover:text-zinc-400 transition-colors duration-200 leading-snug">
      {title}
    </h3>
    {year && (
      <span class="text-sm text-zinc-400 shrink-0 tabular-nums">{year}</span>
    )}
  </div>
  <p class="text-sm text-zinc-500 leading-relaxed mb-2">{description}</p>
  {tags.length > 0 && (
    <p class="text-xs text-zinc-400 tracking-wide">
      {tags.join(' · ')}
    </p>
  )}
</a>
