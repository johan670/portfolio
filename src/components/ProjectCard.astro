---
interface Props {
  title: string;
  description: string;
  href: string;
  cover?: string;
  tags?: string[];
  year?: string;
}

const { title, description, href, cover, tags = [], year } = Astro.props;
---

<a href={href} class="group block">
  <!-- Image -->
  <div class="relative overflow-hidden bg-zinc-50 aspect-[4/3] mb-5">
    {cover ? (
      <img
        src={cover}
        alt={title}
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
      />
    ) : (
      <div class="w-full h-full bg-zinc-100 flex items-center justify-center">
        <span class="text-zinc-300 text-xs tracking-widest uppercase">No image</span>
      </div>
    )}
    <!-- Subtle overlay on hover -->
    <div class="absolute inset-0 bg-black/0 group-hover:bg-black/5 transition-colors duration-300" />
  </div>

  <!-- Meta -->
  <div class="space-y-2">
    <div class="flex items-start justify-between gap-4">
      <h3 class="text-[15px] font-medium text-zinc-900 group-hover:text-zinc-500 transition-colors duration-200 leading-snug">
        {title}
      </h3>
      {year && (
        <span class="text-sm text-zinc-400 shrink-0 tabular-nums">{year}</span>
      )}
    </div>
    <p class="text-sm text-zinc-500 leading-relaxed">{description}</p>
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5 pt-0.5">
        {tags.map(tag => (
          <span class="text-[11px] font-medium text-zinc-400 border border-zinc-200 px-2 py-0.5 rounded-full tracking-wide">
            {tag}
          </span>
        ))}
      </div>
    )}
  </div>
</a>
