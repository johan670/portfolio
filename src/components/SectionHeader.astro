---
interface Props {
  label: string;
  title: string;
}

const { label, title } = Astro.props;
---

<div class="flex items-baseline gap-4 mb-12 pb-6 border-b border-zinc-100">
  <span class="text-xs font-mono text-zinc-300">{label}</span>
  <h2 class="text-2xl font-medium tracking-tight text-zinc-900">{title}</h2>
</div>
