---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const work = await getCollection('work');
  return work.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Base
  title={`${entry.data.title} — Your Name`}
  description={entry.data.description}
  image={entry.data.cover}
>
  <Nav />

  <main class="flex-1 max-w-screen-xl mx-auto w-full">
    <article class="px-6 md:px-10 lg:px-16 pt-14 pb-32">
      <!-- Back -->
      <a
        href="/work"
        class="inline-flex items-center gap-1.5 text-sm text-zinc-400 hover:text-zinc-900 transition-colors duration-200 mb-14"
      >
        ← All work
      </a>

      <!-- Header -->
      <div class="max-w-2xl mb-14">
        <div class="flex flex-wrap gap-1.5 mb-5">
          {entry.data.tags.map(tag => (
            <span class="text-[11px] font-medium text-zinc-400 border border-zinc-200 px-2 py-0.5 rounded-full tracking-wide">
              {tag}
            </span>
          ))}
        </div>
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-medium tracking-tight text-zinc-900 leading-[1.1] mb-4">
          {entry.data.title}
        </h1>
        <p class="text-lg text-zinc-500 leading-relaxed">{entry.data.description}</p>

        <!-- Meta row -->
        <dl class="flex flex-wrap gap-x-10 gap-y-3 mt-8 pt-8 border-t border-zinc-100">
          <div>
            <dt class="text-[11px] uppercase tracking-widest text-zinc-400 mb-1">Year</dt>
            <dd class="text-sm text-zinc-700">{entry.data.year}</dd>
          </div>
          {entry.data.client && (
            <div>
              <dt class="text-[11px] uppercase tracking-widest text-zinc-400 mb-1">Client</dt>
              <dd class="text-sm text-zinc-700">{entry.data.client}</dd>
            </div>
          )}
          {entry.data.role && (
            <div>
              <dt class="text-[11px] uppercase tracking-widest text-zinc-400 mb-1">Role</dt>
              <dd class="text-sm text-zinc-700">{entry.data.role}</dd>
            </div>
          )}
        </dl>
      </div>

      <!-- Cover -->
      {entry.data.cover && (
        <div class="aspect-[16/9] overflow-hidden bg-zinc-50 mb-16">
          <img
            src={entry.data.cover}
            alt={entry.data.title}
            class="w-full h-full object-cover"
          />
        </div>
      )}

      <!-- Body -->
      <div class="max-w-2xl">
        <div
          class="prose prose-zinc max-w-none
            prose-headings:font-medium prose-headings:tracking-tight
            prose-h2:text-2xl prose-h2:mt-16 prose-h2:mb-4
            prose-h3:text-lg prose-h3:mt-10 prose-h3:mb-3
            prose-p:text-zinc-600 prose-p:leading-relaxed prose-p:text-[15px]
            prose-li:text-zinc-600 prose-li:text-[15px]
            prose-a:text-zinc-900 prose-a:underline-offset-4 prose-a:decoration-zinc-300
            prose-strong:text-zinc-900 prose-strong:font-medium
            prose-hr:border-zinc-100
            prose-img:rounded-none prose-img:shadow-none"
        >
          <Content />
        </div>
      </div>
    </article>
  </main>

  <Footer />
</Base>
