---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const allWork = await getCollection('work');
const sorted = allWork.sort((a, b) => a.data.order - b.data.order);
---

<Base title="Work — Your Name" description="Selected UX and product design projects.">
  <Nav />

  <main class="flex-1 max-w-screen-xl mx-auto w-full">
    <section class="px-6 md:px-10 lg:px-16 pt-20 pb-32">
      <h1 class="text-xs font-medium uppercase tracking-widest text-zinc-400 mb-16">
        All Work
      </h1>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-16">
        {sorted.map(project => (
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            href={`/work/${project.slug}`}
            cover={project.data.cover}
            tags={project.data.tags}
            year={project.data.year}
          />
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Base>
