---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allWork = await getCollection('work');
const workLinks = allWork
  .sort((a, b) => a.data.order - b.data.order)
  .map(p => ({ href: `/work/${p.slug}`, label: p.data.title }));

const sections = [
  { id: 'profile',  label: 'Profile'  },
  { id: 'approach', label: 'Approach' },
  { id: 'clients',  label: 'Clients'  },
  { id: 'services', label: 'Services' },
  { id: 'contact',  label: 'Contact'  },
];

const whatIDo = [
  'UX Research & Strategy',
  'Product Design',
  'Interaction Design',
  'Design Systems',
  'Prototyping & Validation',
];

const approachCards = [
  {
    title: 'Research first',
    body:  'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.',
  },
  {
    title: 'Systems thinking',
    body:  'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.',
  },
];

const clientBrands    = ['Lorem Inc', 'Ipsum Studio', 'Dolor GmbH', 'Amet Corp', 'Consectetur', 'Adipiscing', 'Elit Group', 'Sed & Co'];
const clientAgencies  = ['Agency One', 'Studio Two', 'Partners Three', 'Collective Four', 'Design Five', 'Bureau Six'];
const clientCollabs   = ['Collaborator A', 'Collaborator B', 'Collaborator C', 'Collaborator D', 'Collaborator E'];

const services = [
  { title: 'UX Research & Strategy',   description: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation.' },
  { title: 'Product Design',            description: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation.' },
  { title: 'Design Systems',            description: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation.' },
  { title: 'Prototyping & Validation',  description: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation.' },
];

const year = new Date().getFullYear();
---

<Base title="About — Johan Pihl" description="UX & product designer. Research to shipped product.">

  <!-- Grey page wrapper -->
  <div class="bg-[#E5E5E1] flex flex-col flex-1 min-h-screen">

    <!-- ═══════════════════════════════════
         TOP NAV — pill buttons, two rows
    ════════════════════════════════════ -->
    <header class="sticky top-0 z-50 bg-[#E5E5E1]/95 backdrop-blur-sm border-b border-black/10">
      <div class="px-5 lg:px-8">

        <!-- Row 1: main nav + utility -->
        <div class="flex items-center justify-between py-2.5">

          <!-- Left: main nav pills -->
          <nav class="flex items-center gap-1.5">
            <a href="/"
               class="rounded-full border border-black/25 text-xs px-4 py-1.5 text-zinc-800 hover:bg-zinc-900 hover:text-white hover:border-zinc-900 transition-colors duration-200 font-medium">
              Johan Pihl
            </a>
            <a href="/work"
               class="rounded-full border border-black/20 text-xs px-4 py-1.5 text-zinc-600 hover:bg-zinc-900 hover:text-white hover:border-zinc-900 transition-colors duration-200">
              Work
            </a>
            <a href="/about"
               class="rounded-full bg-zinc-900 text-white text-xs px-4 py-1.5 font-medium">
              About
            </a>
          </nav>

          <!-- Right: utility -->
          <div class="flex items-center gap-3">
            <a href="https://linkedin.com/in/johanpihl" target="_blank" rel="noopener noreferrer"
               class="hidden md:block text-xs text-zinc-500 hover:text-zinc-900 transition-colors duration-200">
              LinkedIn
            </a>
            <a href="https://dribbble.com" target="_blank" rel="noopener noreferrer"
               class="hidden md:block text-xs text-zinc-500 hover:text-zinc-900 transition-colors duration-200">
              Dribbble
            </a>
            <a href="/cv.pdf"
               class="rounded-full border border-black/25 text-xs px-3.5 py-1.5 text-zinc-700 hover:bg-zinc-900 hover:text-white hover:border-zinc-900 transition-colors duration-200">
              CV →
            </a>
          </div>
        </div>

        <!-- Row 2: section anchors -->
        <div class="flex items-center gap-1.5 pb-2.5">
          {sections.map(s => (
            <a href={`#${s.id}`}
               class="rounded-full border border-black/20 text-xs px-3.5 py-1 text-zinc-600 hover:bg-zinc-900 hover:text-white hover:border-zinc-900 transition-colors duration-200">
              {s.label}
            </a>
          ))}
        </div>
      </div>
    </header>

    <!-- ═══════════════════════════════════
         MAIN CONTENT
    ════════════════════════════════════ -->
    <main class="flex-1">

      <!-- Intro line + floating action pills -->
      <div class="px-5 lg:px-8 py-12 flex items-end justify-between gap-8">
        <p class="text-sm text-zinc-600 leading-relaxed max-w-sm">
          Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor
          incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam.
        </p>
        <div class="hidden md:flex items-center gap-1.5 shrink-0">
          <a href="mailto:johan@surpriseventures.io"
             class="rounded-full border border-black/25 text-xs px-3.5 py-1.5 text-zinc-700 hover:bg-zinc-900 hover:text-white hover:border-zinc-900 transition-colors duration-200">
            Contact ↗
          </a>
          <a href="/cv.pdf"
             class="rounded-full bg-zinc-900 text-white text-xs px-3.5 py-1.5 hover:bg-zinc-700 transition-colors duration-200">
            CV / Résumé
          </a>
        </div>
      </div>

      <!-- ── PROFILE ── -->
      <section id="profile" class="px-5 lg:px-8 py-16 border-t border-black/10">
        <h2 class="text-[10px] uppercase tracking-widest text-zinc-500 mb-14">Profile</h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 mb-14">
          <div>
            <div class="w-20 h-20 bg-zinc-300 mb-8" />
            <h6 class="text-[10px] uppercase tracking-widest text-zinc-500 mb-5">What I do</h6>
            <ul class="space-y-3">
              {whatIDo.map(item => (
                <li class="text-sm text-zinc-700">{item}</li>
              ))}
            </ul>
          </div>
          <div class="aspect-[3/4] bg-zinc-300 w-full" />
        </div>

        <div class="aspect-[16/7] bg-zinc-300 w-full mb-14" />

        <div class="max-w-2xl space-y-5 mb-12">
          <p class="text-sm text-zinc-700 leading-relaxed">
            Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor
            incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud
            exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.
          </p>
          <p class="text-sm text-zinc-700 leading-relaxed">
            Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu
            fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in
            culpa qui officia deserunt mollit anim id est laborum.
          </p>
        </div>

        <div class="text-xs text-zinc-500 space-y-1.5">
          <p>Available Mon–Fri, Stockholm SE</p>
          <p><a href="mailto:johan@surpriseventures.io"
                class="hover:text-zinc-900 transition-colors duration-200">
            johan@surpriseventures.io
          </a></p>
        </div>
      </section>

      <!-- ── APPROACH ── -->
      <section id="approach" class="px-5 lg:px-8 py-16 border-t border-black/10">
        <h2 class="text-[10px] uppercase tracking-widest text-zinc-500 mb-14">Approach</h2>

        <div class="aspect-[16/9] bg-zinc-300 w-full mb-14" />

        <p class="text-sm text-zinc-700 leading-relaxed max-w-2xl mb-2">
          Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor
          incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud
          exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.
        </p>
        <p class="text-xs text-zinc-500 mb-14">
          Follow on{' '}
          <a href="https://linkedin.com/in/johanpihl" target="_blank" rel="noopener noreferrer"
             class="underline underline-offset-2 hover:text-zinc-900 transition-colors duration-200">LinkedIn</a>,{' '}
          <a href="https://dribbble.com" target="_blank" rel="noopener noreferrer"
             class="underline underline-offset-2 hover:text-zinc-900 transition-colors duration-200">Dribbble</a>.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-10 mb-14">
          {approachCards.map(card => (
            <div>
              <div class="w-16 h-16 bg-zinc-300 mb-5" />
              <h6 class="text-[10px] uppercase tracking-widest text-zinc-500 mb-3">{card.title}</h6>
              <p class="text-xs text-zinc-600 leading-relaxed">{card.body}</p>
            </div>
          ))}
        </div>

        <div class="aspect-[16/9] bg-zinc-300 w-full" />
      </section>

      <!-- ── CLIENTS ── -->
      <section id="clients" class="px-5 lg:px-8 py-16 border-t border-black/10">
        <h2 class="text-[10px] uppercase tracking-widest text-zinc-500 mb-6">Clients</h2>
        <p class="text-sm text-zinc-700 leading-relaxed max-w-2xl mb-14">
          Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor
          incididunt ut labore et dolore magna aliqua.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
          <div>
            <h6 class="text-[10px] uppercase tracking-widest text-zinc-400 mb-5">Brands</h6>
            <ul class="space-y-3">{clientBrands.map(c => <li class="text-sm text-zinc-700">{c}</li>)}</ul>
          </div>
          <div>
            <h6 class="text-[10px] uppercase tracking-widest text-zinc-400 mb-5">Agencies</h6>
            <ul class="space-y-3">{clientAgencies.map(c => <li class="text-sm text-zinc-700">{c}</li>)}</ul>
          </div>
          <div>
            <h6 class="text-[10px] uppercase tracking-widest text-zinc-400 mb-5">Collaborators</h6>
            <ul class="space-y-3">{clientCollabs.map(c => <li class="text-sm text-zinc-700">{c}</li>)}</ul>
          </div>
        </div>
      </section>

      <!-- ── SERVICES ── -->
      <section id="services" class="px-5 lg:px-8 py-16 border-t border-black/10">
        <h2 class="text-[10px] uppercase tracking-widest text-zinc-500 mb-6">Services</h2>
        <p class="text-sm text-zinc-700 leading-relaxed max-w-2xl mb-2">
          Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor
          incididunt ut labore et dolore magna aliqua.
        </p>
        <p class="text-xs text-zinc-500 mb-14">
          <a href="mailto:johan@surpriseventures.io"
             class="underline underline-offset-2 hover:text-zinc-900 transition-colors duration-200">Contact</a> to learn more.
        </p>

        <div>
          {services.map(s => (
            <div class="grid grid-cols-1 md:grid-cols-[1fr_2fr] gap-10 py-12 border-t border-black/10">
              <div>
                <div class="aspect-[4/3] bg-zinc-300 mb-3" />
                <p class="text-[10px] text-zinc-400">1/3</p>
              </div>
              <div class="flex flex-col justify-center">
                <h3 class="text-sm font-medium text-zinc-900 mb-3">{s.title}</h3>
                <p class="text-sm text-zinc-600 leading-relaxed">{s.description}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- ── CONTACT ── -->
      <section id="contact" class="px-5 lg:px-8 py-16 border-t border-black/10">
        <h2 class="text-[10px] uppercase tracking-widest text-zinc-500 mb-14">Contact</h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
          {[
            { title: 'Get in touch', body: 'Available for new projects and collaborations. Reach out directly to discuss your needs.', link: { href: 'mailto:johan@surpriseventures.io', label: 'Email →' } },
            { title: 'Availability',  body: 'Currently available for freelance projects and selected full-time roles. Based in Stockholm, SE.', link: null as { href: string; label: string } | null },
            { title: 'Follow',        body: 'See work in progress, case studies, and design thinking on LinkedIn and Dribbble.', link: { href: 'https://linkedin.com/in/johanpihl', label: 'LinkedIn →' } },
          ].map(card => (
            <div>
              <div class="w-16 h-16 bg-zinc-300 mb-5" />
              <h6 class="text-[10px] uppercase tracking-widest text-zinc-500 mb-3">{card.title}</h6>
              <p class="text-xs text-zinc-600 leading-relaxed mb-4">{card.body}</p>
              {card.link && (
                <a href={card.link.href}
                   class="text-xs text-zinc-900 border-b border-zinc-900 pb-px hover:text-zinc-500 hover:border-zinc-500 transition-colors duration-200">
                  {card.link.label}
                </a>
              )}
            </div>
          ))}
        </div>
      </section>
    </main>

    <!-- ═══════════════════════════════════
         FOOTER — pill bar + column grid
    ════════════════════════════════════ -->
    <footer class="border-t border-black/10">

      <!-- Pill action bar (mirrors Displaay's Offline / Newsletter / Ask Albert row) -->
      <div class="px-5 lg:px-8 py-5 flex items-center justify-between border-b border-black/10">
        <div class="flex items-center gap-1.5">
          <a href="mailto:johan@surpriseventures.io"
             class="rounded-full border border-black/25 text-xs px-3.5 py-1.5 text-zinc-700 hover:bg-zinc-900 hover:text-white hover:border-zinc-900 transition-colors duration-200">
            Email ↗
          </a>
          <a href="/cv.pdf"
             class="rounded-full border border-black/25 text-xs px-3.5 py-1.5 text-zinc-700 hover:bg-zinc-900 hover:text-white hover:border-zinc-900 transition-colors duration-200">
            CV / Résumé
          </a>
          <a href="https://linkedin.com/in/johanpihl" target="_blank" rel="noopener noreferrer"
             class="rounded-full bg-zinc-900 text-white text-xs px-3.5 py-1.5 hover:bg-zinc-700 transition-colors duration-200">
            LinkedIn ↗
          </a>
        </div>
        <!-- Monogram (mirrors Displaay's D / DD logo marks) -->
        <span class="text-sm font-medium text-zinc-400 tracking-widest select-none">JP</span>
      </div>

      <!-- Column grid -->
      <div class="px-5 lg:px-8 pt-10 pb-14">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-10">

          <!-- WORK -->
          <div>
            <p class="text-[10px] uppercase tracking-widest text-zinc-500 mb-4">Work</p>
            <nav class="space-y-2.5">
              {workLinks.map(l => (
                <a href={l.href}
                   class="block text-xs text-zinc-600 hover:text-zinc-900 transition-colors duration-200 leading-snug">
                  {l.label}
                </a>
              ))}
              <a href="/work"
                 class="block text-xs text-zinc-500 hover:text-zinc-900 transition-colors duration-200">
                All work →
              </a>
            </nav>
          </div>

          <!-- ABOUT -->
          <div>
            <p class="text-[10px] uppercase tracking-widest text-zinc-500 mb-4">About</p>
            <nav class="space-y-2.5">
              {sections.map(s => (
                <a href={`#${s.id}`}
                   class="block text-xs text-zinc-600 hover:text-zinc-900 transition-colors duration-200">
                  {s.label}
                </a>
              ))}
            </nav>
          </div>

          <!-- SITE -->
          <div>
            <p class="text-[10px] uppercase tracking-widest text-zinc-500 mb-4">Site</p>
            <nav class="space-y-2.5">
              <a href="/"      class="block text-xs text-zinc-600 hover:text-zinc-900 transition-colors duration-200">Home</a>
              <a href="/work"  class="block text-xs text-zinc-600 hover:text-zinc-900 transition-colors duration-200">Work</a>
              <a href="/about" class="block text-xs text-zinc-600 hover:text-zinc-900 transition-colors duration-200">About</a>
              {sections.map(s => (
                <a href={`#${s.id}`}
                   class="block text-xs text-zinc-500 hover:text-zinc-900 transition-colors duration-200 pl-2">
                  —{s.label}
                </a>
              ))}
              <a href="mailto:johan@surpriseventures.io"
                 class="block text-xs text-zinc-600 hover:text-zinc-900 transition-colors duration-200">
                Contact
              </a>
            </nav>
          </div>

          <!-- FOLLOW US -->
          <div>
            <p class="text-[10px] uppercase tracking-widest text-zinc-500 mb-4">Follow us</p>
            <nav class="space-y-2.5">
              <a href="https://linkedin.com/in/johanpihl" target="_blank" rel="noopener noreferrer"
                 class="block text-xs text-zinc-600 hover:text-zinc-900 transition-colors duration-200">LinkedIn</a>
              <a href="https://dribbble.com" target="_blank" rel="noopener noreferrer"
                 class="block text-xs text-zinc-600 hover:text-zinc-900 transition-colors duration-200">Dribbble</a>
            </nav>
          </div>
        </div>
      </div>

      <!-- Copyright line -->
      <div class="px-5 lg:px-8 pb-6 border-t border-black/10 pt-4">
        <p class="text-xs text-zinc-400">© {year} Johan Pihl</p>
      </div>
    </footer>

  </div>
</Base>
