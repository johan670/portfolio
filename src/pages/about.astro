---
import Base from '../layouts/Base.astro';

const sections = [
  { id: 'profile',  label: 'Profile'  },
  { id: 'approach', label: 'Approach' },
  { id: 'clients',  label: 'Clients'  },
  { id: 'services', label: 'Services' },
  { id: 'contact',  label: 'Contact'  },
];

const whatIDo = [
  'UX Research & Strategy',
  'Product Design',
  'Interaction Design',
  'Design Systems',
  'Prototyping & Validation',
];

const approachCards = [
  {
    title: 'Research first',
    body:  'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.',
  },
  {
    title: 'Systems thinking',
    body:  'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.',
  },
];

const clientBrands = [
  'Lorem Inc', 'Ipsum Studio', 'Dolor GmbH', 'Amet Corp',
  'Consectetur', 'Adipiscing', 'Elit Group', 'Sed & Co',
];
const clientAgencies = [
  'Agency One', 'Studio Two', 'Partners Three',
  'Collective Four', 'Design Five', 'Bureau Six',
];
const clientCollabs = [
  'Collaborator A', 'Collaborator B', 'Collaborator C',
  'Collaborator D', 'Collaborator E',
];

const services = [
  {
    title: 'UX Research & Strategy',
    description: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip.',
  },
  {
    title: 'Product Design',
    description: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip.',
  },
  {
    title: 'Design Systems',
    description: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip.',
  },
  {
    title: 'Prototyping & Validation',
    description: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip.',
  },
];

const contactCards = [
  {
    title: 'Get in touch',
    body:  'Available for new projects and collaborations. Reach out directly to discuss your needs.',
    link:  { href: 'mailto:johan@surpriseventures.io', label: 'Email →' },
  },
  {
    title: 'Availability',
    body:  'Currently available for freelance projects and selected full-time roles. Based in Stockholm, SE.',
    link:  null as { href: string; label: string } | null,
  },
  {
    title: 'Follow',
    body:  'See work in progress, case studies, and design thinking on LinkedIn and Dribbble.',
    link:  { href: 'https://linkedin.com/in/johanpihl', label: 'LinkedIn →' },
  },
];
---

<Base title="About — Johan Pihl" description="UX & product designer. Research to shipped product.">

  <!-- Mobile nav bar (shown when sidebar is hidden) -->
  <header class="lg:hidden sticky top-0 z-50 bg-white/90 backdrop-blur-sm border-b border-zinc-200">
    <nav class="flex items-center justify-between px-6 py-4">
      <a href="/" class="text-sm font-medium text-zinc-900">Johan Pihl</a>
      <div class="flex items-center gap-6">
        <a href="/work"  class="text-sm text-zinc-400 hover:text-zinc-900 transition-colors duration-200">Work</a>
        <a href="/about" class="text-sm text-zinc-900 font-medium">About</a>
      </div>
    </nav>
  </header>

  <!-- Page shell: sidebar + content -->
  <div class="flex flex-1">

    <!-- ─────────── SIDEBAR ─────────── -->
    <aside class="hidden lg:flex flex-col w-52 xl:w-60 shrink-0 border-r border-zinc-100 sticky top-0 h-screen overflow-y-auto py-9 px-8">

      <!-- Wordmark -->
      <a href="/" class="text-sm font-medium text-zinc-900 hover:text-zinc-400 transition-colors duration-200 mb-10 block">
        Johan Pihl
      </a>

      <!-- Site nav -->
      <nav class="space-y-2.5 mb-10">
        <a href="/work"
           class="block text-xs text-zinc-400 hover:text-zinc-900 transition-colors duration-200">
          Work
        </a>
        <a href="/about"
           class="block text-xs text-zinc-900 font-medium">
          About
        </a>
      </nav>

      <!-- Section anchors -->
      <div class="mb-auto">
        <p class="text-[10px] uppercase tracking-widest text-zinc-300 mb-3">Sections</p>
        <nav class="space-y-2.5">
          {sections.map(s => (
            <a href={`#${s.id}`}
               class="block text-xs text-zinc-400 hover:text-zinc-900 transition-colors duration-200">
              — {s.label}
            </a>
          ))}
        </nav>
      </div>

      <!-- Socials -->
      <div class="space-y-2 mt-8">
        <a href="https://linkedin.com/in/johanpihl" target="_blank" rel="noopener noreferrer"
           class="block text-xs text-zinc-400 hover:text-zinc-900 transition-colors duration-200">
          LinkedIn
        </a>
        <a href="https://dribbble.com" target="_blank" rel="noopener noreferrer"
           class="block text-xs text-zinc-400 hover:text-zinc-900 transition-colors duration-200">
          Dribbble
        </a>
      </div>
    </aside>

    <!-- ─────────── MAIN CONTENT ─────────── -->
    <main class="flex-1 min-w-0">

      <!-- Intro tagline -->
      <div class="px-10 lg:px-16 py-14 border-b border-zinc-100">
        <p class="text-sm text-zinc-500 leading-relaxed max-w-lg">
          Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor
          incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud
          exercitation ullamco laboris.
        </p>
      </div>

      <!-- ══════════ PROFILE ══════════ -->
      <section id="profile" class="px-10 lg:px-16 py-16 border-b border-zinc-100">
        <h2 class="text-[10px] uppercase tracking-widest text-zinc-400 mb-14">Profile</h2>

        <!-- Illustration + list / Portrait -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 mb-14">
          <div>
            <!-- Small illustration placeholder -->
            <div class="w-20 h-20 bg-zinc-100 mb-8" />
            <h6 class="text-[10px] uppercase tracking-widest text-zinc-400 mb-5">What I do</h6>
            <ul class="space-y-3">
              {whatIDo.map(item => (
                <li class="text-sm text-zinc-600">{item}</li>
              ))}
            </ul>
          </div>
          <!-- Portrait placeholder -->
          <div class="aspect-[3/4] bg-zinc-100 w-full" />
        </div>

        <!-- Large profile image -->
        <div class="aspect-[16/7] bg-zinc-100 w-full mb-14" />

        <!-- Body copy -->
        <div class="max-w-2xl space-y-5 mb-12">
          <p class="text-sm text-zinc-600 leading-relaxed">
            Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor
            incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud
            exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.
          </p>
          <p class="text-sm text-zinc-600 leading-relaxed">
            Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu
            fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in
            culpa qui officia deserunt mollit anim id est laborum.
          </p>
        </div>

        <!-- Availability line -->
        <div class="text-xs text-zinc-400 space-y-1.5">
          <p>Available Mon–Fri, Stockholm SE</p>
          <p>
            <a href="mailto:johan@surpriseventures.io"
               class="hover:text-zinc-900 transition-colors duration-200">
              johan@surpriseventures.io
            </a>
          </p>
        </div>
      </section>

      <!-- ══════════ APPROACH ══════════ -->
      <section id="approach" class="px-10 lg:px-16 py-16 border-b border-zinc-100">
        <h2 class="text-[10px] uppercase tracking-widest text-zinc-400 mb-14">Approach</h2>

        <!-- Large landscape image -->
        <div class="aspect-[16/9] bg-zinc-100 w-full mb-14" />

        <!-- Body text + social follow -->
        <p class="text-sm text-zinc-600 leading-relaxed max-w-2xl mb-4">
          Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor
          incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud
          exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.
        </p>
        <p class="text-xs text-zinc-400 mb-14">
          Follow on{' '}
          <a href="https://linkedin.com/in/johanpihl" target="_blank" rel="noopener noreferrer"
             class="underline underline-offset-2 hover:text-zinc-900 transition-colors duration-200">LinkedIn</a>,{' '}
          <a href="https://dribbble.com" target="_blank" rel="noopener noreferrer"
             class="underline underline-offset-2 hover:text-zinc-900 transition-colors duration-200">Dribbble</a>.
        </p>

        <!-- Two illustration cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-10 mb-14">
          {approachCards.map(card => (
            <div>
              <div class="w-16 h-16 bg-zinc-100 mb-5" />
              <h6 class="text-[10px] uppercase tracking-widest text-zinc-400 mb-3">{card.title}</h6>
              <p class="text-xs text-zinc-500 leading-relaxed">{card.body}</p>
            </div>
          ))}
        </div>

        <!-- Second large image -->
        <div class="aspect-[16/9] bg-zinc-100 w-full" />
      </section>

      <!-- ══════════ CLIENTS ══════════ -->
      <section id="clients" class="px-10 lg:px-16 py-16 border-b border-zinc-100">
        <h2 class="text-[10px] uppercase tracking-widest text-zinc-400 mb-6">Clients</h2>
        <p class="text-sm text-zinc-500 leading-relaxed max-w-2xl mb-14">
          Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor
          incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
          <div>
            <h6 class="text-[10px] uppercase tracking-widest text-zinc-300 mb-5">Brands</h6>
            <ul class="space-y-3">
              {clientBrands.map(c => <li class="text-sm text-zinc-600">{c}</li>)}
            </ul>
          </div>
          <div>
            <h6 class="text-[10px] uppercase tracking-widest text-zinc-300 mb-5">Agencies</h6>
            <ul class="space-y-3">
              {clientAgencies.map(c => <li class="text-sm text-zinc-600">{c}</li>)}
            </ul>
          </div>
          <div>
            <h6 class="text-[10px] uppercase tracking-widest text-zinc-300 mb-5">Collaborators</h6>
            <ul class="space-y-3">
              {clientCollabs.map(c => <li class="text-sm text-zinc-600">{c}</li>)}
            </ul>
          </div>
        </div>
      </section>

      <!-- ══════════ SERVICES ══════════ -->
      <section id="services" class="px-10 lg:px-16 py-16 border-b border-zinc-100">
        <h2 class="text-[10px] uppercase tracking-widest text-zinc-400 mb-6">Services</h2>
        <p class="text-sm text-zinc-500 leading-relaxed max-w-2xl mb-4">
          Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor
          incididunt ut labore et dolore magna aliqua.
        </p>
        <p class="text-xs text-zinc-400 mb-14">
          <a href="mailto:johan@surpriseventures.io"
             class="underline underline-offset-2 hover:text-zinc-900 transition-colors duration-200">
            Contact
          </a> to learn more.
        </p>

        <div>
          {services.map(s => (
            <div class="grid grid-cols-1 md:grid-cols-[1fr_2fr] gap-10 py-12 border-t border-zinc-100">
              <!-- Image placeholder with carousel indicator (static) -->
              <div>
                <div class="aspect-[4/3] bg-zinc-100 mb-3" />
                <p class="text-[10px] text-zinc-300">1/3</p>
              </div>
              <div class="flex flex-col justify-center">
                <h3 class="text-sm font-medium text-zinc-900 mb-3">{s.title}</h3>
                <p class="text-sm text-zinc-500 leading-relaxed">{s.description}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- ══════════ CONTACT ══════════ -->
      <section id="contact" class="px-10 lg:px-16 py-16 border-b border-zinc-100">
        <h2 class="text-[10px] uppercase tracking-widest text-zinc-400 mb-14">Contact</h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
          {contactCards.map(card => (
            <div>
              <div class="w-16 h-16 bg-zinc-100 mb-5" />
              <h6 class="text-[10px] uppercase tracking-widest text-zinc-400 mb-3">{card.title}</h6>
              <p class="text-xs text-zinc-500 leading-relaxed mb-4">{card.body}</p>
              {card.link && (
                <a href={card.link.href}
                   class="text-xs text-zinc-900 border-b border-zinc-900 pb-px hover:text-zinc-400 hover:border-zinc-400 transition-colors duration-200">
                  {card.link.label}
                </a>
              )}
            </div>
          ))}
        </div>
      </section>

      <!-- Page footer -->
      <div class="px-10 lg:px-16 py-8">
        <p class="text-xs text-zinc-400">© {new Date().getFullYear()} Johan Pihl</p>
      </div>

    </main>
  </div>

</Base>
