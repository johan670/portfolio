---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const allWork = await getCollection('work');
const featured = allWork
  .filter(p => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<Base title="Your Name — UX & Product Designer">
  <Nav />

  <main class="flex-1 max-w-screen-xl mx-auto w-full">
    <!-- Hero -->
    <section class="px-6 md:px-10 lg:px-16 pt-24 pb-28 md:pt-32 md:pb-36">
      <div class="max-w-3xl">
        <p class="text-xs font-medium uppercase tracking-widest text-zinc-400 mb-8">
          Available for projects
        </p>
        <h1 class="text-[2.75rem] md:text-6xl lg:text-7xl font-medium tracking-tight text-zinc-900 leading-[1.08] mb-8">
          Designing products<br class="hidden md:block" /> people want to use.
        </h1>
        <p class="text-lg md:text-xl text-zinc-500 leading-relaxed max-w-lg">
          UX & product designer. I work with teams building tools, platforms,
          and apps — from early research to shipped product.
        </p>
      </div>
    </section>

    <!-- Work -->
    <section class="px-6 md:px-10 lg:px-16 pb-32">
      <div class="flex items-center justify-between mb-12">
        <h2 class="text-xs font-medium uppercase tracking-widest text-zinc-400">
          Selected Work
        </h2>
        <a
          href="/work"
          class="text-sm text-zinc-400 hover:text-zinc-900 transition-colors duration-200"
        >
          All projects →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-16">
        {featured.map(project => (
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            href={`/work/${project.slug}`}
            cover={project.data.cover}
            tags={project.data.tags}
            year={project.data.year}
          />
        ))}
      </div>
    </section>

    <!-- CTA strip -->
    <section class="px-6 md:px-10 lg:px-16 pb-32">
      <div class="border-t border-zinc-100 pt-16 flex flex-col md:flex-row md:items-center justify-between gap-8">
        <div>
          <p class="text-2xl md:text-3xl font-medium tracking-tight text-zinc-900 mb-2">
            Let's work together.
          </p>
          <p class="text-zinc-500">Open to freelance and full-time opportunities.</p>
        </div>
        <a
          href="mailto:hello@example.com"
          class="inline-flex items-center gap-2 bg-zinc-900 text-white text-sm font-medium px-6 py-3 hover:bg-zinc-700 transition-colors duration-200 shrink-0"
        >
          Get in touch →
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Base>
