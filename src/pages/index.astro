---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const allWork = await getCollection('work');
const featured = allWork
  .filter(p => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<Base title="Johan Pihl — UX & Product Designer">
  <Nav />

  <main class="flex-1 max-w-screen-xl mx-auto w-full">

    <!-- Hero -->
    <section class="px-6 md:px-10 lg:px-16 pt-16 pb-16 md:pt-24 md:pb-20">
      <h1 class="text-5xl md:text-7xl lg:text-8xl font-medium leading-[1.0] text-zinc-900 mb-8 max-w-4xl">
        Designing products people want to use.
      </h1>
      <p class="text-sm md:text-base text-zinc-500 leading-relaxed max-w-xs">
        UX & product designer. Research to shipped product.
      </p>
    </section>

    <!-- Divider -->
    <div class="border-t border-zinc-200 mx-6 md:mx-10 lg:mx-16" />

    <!-- Work -->
    <section class="px-6 md:px-10 lg:px-16 pt-10 pb-32">
      <div class="flex items-center justify-between mb-10">
        <span class="text-xs font-medium uppercase tracking-widest text-zinc-400">Selected Work</span>
        <a href="/work" class="text-xs font-medium uppercase tracking-widest text-zinc-400 hover:text-zinc-900 transition-colors duration-200">
          All →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-16">
        {featured.map(project => (
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            href={`/work/${project.slug}`}
            cover={project.data.cover}
            tags={project.data.tags}
            year={project.data.year}
          />
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="px-6 md:px-10 lg:px-16 pb-24">
      <div class="border-t border-zinc-200 pt-12 flex flex-col md:flex-row md:items-center justify-between gap-8">
        <p class="text-2xl md:text-3xl font-medium tracking-tight text-zinc-900">
          Let's work together.
        </p>
        <a
          href="mailto:johan@surpriseventures.io"
          class="text-sm font-medium text-zinc-900 border-b border-zinc-900 pb-px hover:text-zinc-400 hover:border-zinc-400 transition-colors duration-200 shrink-0"
        >
          johan@surpriseventures.io →
        </a>
      </div>
    </section>

  </main>

  <Footer />
</Base>
